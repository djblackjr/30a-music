# 30A Music Intelligence — Environment Variables
# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit your actual keys.

# Required for image ingestion via GPT-4o Vision
OPENAI_API_KEY=sk-...your-key-here...

# Required for run_favorites_watch.py's push notifications. Pick any hard-to-
# guess topic name (this repo is public — anyone who knows the topic name
# can read or publish to it) and subscribe to it in the ntfy app (iOS/
# Android) or at https://ntfy.sh/<topic> in a browser. No account needed.
NTFY_TOPIC=your-private-topic-name-here
